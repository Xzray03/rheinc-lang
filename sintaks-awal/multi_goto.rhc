-- ============================================================
-- MULTI GOTO — Lompatan label dengan banyak sumber goto
-- ============================================================

fungsi utama() -> bilangan {
    -- Test 1: dua goto MUNDUR dari cabang berbeda (loop majemuk)
    variabel i: bilangan = 0
    variabel n: bilangan = 0
    ulang: {
        n = n + 1
        i = i + 1
        jika i < 3 maka {
            goto ulang
        }
        jika n < 5 maka {
            goto ulang
        }
    }
    -- alur: i=1..3 via cabang-1 (n=1..3), i=4..5 via cabang-2 (n=4..5)
    tampilkan "T1: i = ", i, ", n = ", n, "\n"

    -- Test 2: goto mundur + pemakaian label setelahnya (maju)
    variabel a: bilangan = 0
    variabel b: bilangan = 0
    lagi: {
        a = a + 1
        jika a < 4 maka {
            goto lagi
        }
        b = a * 10
    }
    selesai: {
        tampilkan "T2: a = ", a, ", b = ", b, "\n"
    }

    kembalikan 0
}
