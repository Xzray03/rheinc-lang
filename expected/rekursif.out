=== PANGKAT (Tail Recursion) ===
2^8 = 256
3^4 = 81
5^3 = 125
10^0 = 1
2^10 = 1024
=== JUMLAH DIGIT (Tail Recursion) ===
jumlah_digit(12345) = 15
jumlah_digit(987654) = 39
jumlah_digit(100) = 1
jumlah_digit(99999) = 45
=== GCD / FPB (Tail Recursion) ===
gcd(48, 18) = 6
gcd(100, 35) = 5
gcd(17, 13) = 1
gcd(270, 192) = 6
=== SUM 1 TO N (Tail Recursion) ===
sum(5) = 15
sum(10) = 55
sum(100) = 5050
=== REVERSE NUMBER (Tail Recursion) ===
reverse(12345) = 54321
reverse(987654) = 456789
reverse(100) = 1
=== PALINDROME CHECK ===
is_palindrome(12321) = benar
is_palindrome(12345) = salah
is_palindrome(98789) = benar
=== BINARY DIGITS (Tail Recursion) ===
binary_digits(0) = 1
binary_digits(1) = 1
binary_digits(255) = 8
binary_digits(1024) = 11
