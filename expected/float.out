=== TEST DESIMAL ===

--- Test 1: Bilangan Positif ---
  1.5          = 1.5
  3.14         = 3.14
  5.5          = 5.5
  0.0          = 0
  0.1          = 0.1
  0.001        = 0.001
  100.5        = 100.5
  999.999      = 999.999
  1.0          = 1
  2.718281828  = 2.718282

--- Test 2: Bilangan Negatif ---
  -1.5         = -1.5
  -3.14        = -3.14
  -5.5         = -5.5
  -0.0         = -0
  -0.1         = -0.1
  -100.5       = -100.5
  -999.999     = -999.999
  -1.0         = -1

--- Test 3: Bilangan Sangat Kecil ---
   0.000001    = 0.000001
   0.0000001   = 0
   1e-10       = 0
  -0.000001    = -0.000001
  -0.0000001   = -0

--- Test 4: Bilangan Sangat Besar ---
   1000000.5   = 1000000.5
   9999999.999 = 9999999.999
   1e10        = 10000000000
  -1000000.5   = -1000000.5

--- Test 5: Bilangan Bulat sebagai Desimal ---
   1.0         = 1
   0.0         = 0
   42.0        = 42
  -7.0         = -7
   100.0       = 100
  -0.0         = -0

--- Test 6: Nilai Presisi ---
   0.123456789  = 0.123457
   1.23456789   = 1.234568
   12.3456789   = 12.345679
   123.456789   = 123.456789
   1234.56789   = 1234.56789
   12345.6789   = 12345.6789
  -0.123456789  = -0.123457

--- Test 7: Konstanta Pendekatan ---
   pi           = 3.141593
   e            = 2.718282
   phi          = 1.618034
   sqrt(2)      = 1.414214

